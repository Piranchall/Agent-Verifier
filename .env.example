# ---- Which LLM runs the agents -----------------------------------------
# mock   = offline fake agents, no key needed (for building the UI)
# groq   = free tier, no credit card: https://console.groq.com/keys
# gemini = free tier: https://aistudio.google.com/apikey
# ollama = local models, no key (needs a decent GPU)
LLM_PROVIDER=mock

GROQ_API_KEY=
GEMINI_API_KEY=

# Optional overrides (each provider has a sensible default)
# LLM_MODEL=openai/gpt-oss-120b
# LLM_BASE_URL=
# LLM_REASONING_EFFORT=low
# LLM_TEMPERATURE=0.7
# LLM_MIN_INTERVAL=2

# ---- Agent team ---------------------------------------------------------
# The planner splits the work into at most this many steps, then one fix-up round if needed
PLAN_MAX_STEPS=3
FIXUP_ROUNDS=1
DEFAULT_REPLAYS=3
MIN_REPLAYS=3
MAX_REPLAYS=5
# No-change replays per step, shown as "Without your change: b of m"
BASELINE_REPLAYS=3

# ---- Study ---------------------------------------------------------------
# Planted errors (wrong suggestions, inflated "k of n") only work with this on.
# Keep it off for demos and normal use, so the tool never shows faked evidence.
STUDY_MODE=off

# ---- Feature 3: actions that can't be undone ---------------------------
# on  = runs whose visible tests pass end with a simulated release: deploy to
#       staging, deploy to production, email the customer. Replays re-do them
#       unless the person holds them. Nothing real happens.
# off = no release step (the app behaves as before)
RELEASE_ACTIONS=off

# ---- Where the agents' code is tested -----------------------------------
# docker = isolated container, network off (use this)
# local  = your own Python, NOT isolated (only if Docker isn't working yet)
SANDBOX=docker
DOCKER_IMAGE=python:3.11-slim
TEST_TIMEOUT=40
